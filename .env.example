# Copy to .env (git-ignored). Only apps/server reads this file; the browser never sees it.

# Port for the local API. If you change it, set the same value when starting Vite,
# because its /api proxy reads API_PORT too.
API_PORT=8787

# Optional. You can also choose an AI service in the app, under Settings > Your AI, which
# takes priority. Without either, the app works and AI stays off.
ANTHROPIC_API_KEY=

# Optional. Model used with the key above. Defaults to claude-haiku-5-5.
ANTHROPIC_FAST_MODEL=

# Optional. Where saved AI settings are kept. Defaults to .data/ at the root of the repo.
# LF_DATA_DIR=

# Only for hosting, which also needs logins (Phase 6). See "Secrets and users" in the README.
# LF_HOSTED=1
# AI_SECRETS_KEY=   (32 random bytes in base64: openssl rand -base64 32)
